# ==========================================
# VulnForge Platform Environment Configuration
# ==========================================

# Branding & App
APP_NAME=VulnForge
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Security & Secret Keys (Change in Production!)
SECRET_KEY=vulnforge-super-secret-production-change-me-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./vulnforge.db
SYNC_DATABASE_URL=sqlite:///./vulnforge.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://vulnforge:vulnforge_password@localhost:5432/vulnforge_db
# SYNC_DATABASE_URL=postgresql://vulnforge:vulnforge_password@localhost:5432/vulnforge_db

# Redis & Worker
REDIS_URL=redis://localhost:6379/0
USE_IN_PROCESS_WORKER=true

# Scope & Scanner Safety
SCAN_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_SCANS=5
DEFAULT_RATE_LIMIT_RPS=20
ALLOW_LOCAL_TARGETS=true

# AI Security Copilot Provider ("mock" | "openai" | "gemini" | "local")
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

# External Scanner Executable Paths (Optional, auto-detected in PATH)
NMAP_PATH=nmap
NUCLEI_PATH=nuclei
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=
